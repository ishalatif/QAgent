{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qagent.local/schemas/qa.config.schema.json",
  "title": "QAgent qa.config.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "target"],
  "properties": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment"],
      "properties": {
        "environment": { "enum": ["local", "development", "staging", "production"] },
        "url": { "type": "string", "minLength": 1 },
        "allowed_hosts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "fallback_to_cloud": { "type": "boolean" },
        "commands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "install": { "$ref": "#/definitions/sourceCommand" },
            "lint": { "$ref": "#/definitions/sourceCommand" },
            "typecheck": { "$ref": "#/definitions/sourceCommand" },
            "test": { "$ref": "#/definitions/sourceCommand" },
            "build": { "$ref": "#/definitions/sourceCommand" },
            "start": { "$ref": "#/definitions/sourceCommand" }
          }
        },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 }
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destructive": { "type": "boolean" },
        "active_security_scan": { "type": "boolean" },
        "load_test": { "type": "boolean" },
        "max_concurrency": { "type": "integer", "minimum": 1, "maximum": 50 },
        "allow_source_commands": { "type": "boolean" },
        "confirmation_token": { "type": "string", "minLength": 1 }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["loginUrl", "credentials", "selectors", "success"],
            "properties": {
              "loginUrl": { "type": "string", "minLength": 1 },
              "credentials": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "password"],
                "properties": {
                  "username": { "type": "string", "minLength": 1 },
                  "password": { "type": "string", "minLength": 1 }
                }
              },
              "selectors": {
                "type": "object",
                "additionalProperties": false,
                "required": ["username", "password", "submit"],
                "properties": {
                  "username": { "type": "string", "minLength": 1 },
                  "password": { "type": "string", "minLength": 1 },
                  "submit": { "type": "string", "minLength": 1 }
                }
              },
              "success": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "urlContains": { "type": "string", "minLength": 1 },
                  "selector": { "type": "string", "minLength": 1 }
                }
              },
              "api": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "headers": { "$ref": "#/definitions/stringMap" }
                }
              }
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_url": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiAssertion" }
        },
        "authorization": {
          "type": "array",
          "items": { "$ref": "#/definitions/apiAuthorizationCase" }
        },
        "openapi": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["axe"] },
        "failOn": {
          "type": "array",
          "items": { "$ref": "#/definitions/accessibilityImpact" },
          "uniqueItems": true
        },
        "maxViolations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "critical": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "serious": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "moderate": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "minor": { "type": "integer", "minimum": 0, "maximum": 100000 },
            "none": { "type": "integer", "minimum": 0, "maximum": 100000 }
          }
        },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 250 },
        "profiles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxNodesPerRule": { "type": "integer", "minimum": 1, "maximum": 50 }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["browser-timing"] },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 250 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "waitUntil": { "enum": ["domcontentloaded", "load", "networkidle"] },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxFirstByteMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "maxDomContentLoadedMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "maxLoadEventMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "maxTransferSizeBytes": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
            "maxResourceCount": { "type": "integer", "minimum": 0, "maximum": 1000000 }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["passive-http"] },
        "failOn": {
          "type": "array",
          "items": { "$ref": "#/definitions/securityCheck" },
          "uniqueItems": true
        },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 250 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content-security-policy": { "type": "boolean" },
            "frame-protection": { "type": "boolean" },
            "x-content-type-options": { "type": "boolean" },
            "referrer-policy": { "type": "boolean" },
            "strict-transport-security": { "type": "boolean" },
            "cookie-http-only": { "type": "boolean" },
            "cookie-secure": { "type": "boolean" },
            "cookie-same-site": { "type": "boolean" }
          }
        }
      }
    },
    "load": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "engine": { "enum": ["http-smoke"] },
        "include": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "maxPages": { "type": "integer", "minimum": 1, "maximum": 25 },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "requestsPerTarget": { "type": "integer", "minimum": 1, "maximum": 100 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 10 },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxErrorRate": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxAverageMs": { "type": "integer", "minimum": 0, "maximum": 300000 },
            "maxP95Ms": { "type": "integer", "minimum": 0, "maximum": 300000 }
          }
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_pages": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_depth": { "type": "integer", "minimum": 0, "maximum": 20 },
        "same_origin_only": { "type": "boolean" },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "config",
              "source",
              "browser",
              "api",
              "authorization",
              "accessibility",
              "performance",
              "security",
              "load",
              "reporting"
            ]
          },
          "uniqueItems": true
        },
        "retries": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "allow": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "deny": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["html", "json", "junit", "xlsx"] },
          "uniqueItems": true
        },
        "evidence_on": { "enum": ["failure", "always", "never"] },
        "redact_headers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  },
  "definitions": {
    "accessibilityImpact": {
      "enum": ["critical", "serious", "moderate", "minor", "none"]
    },
    "securityCheck": {
      "enum": [
        "content-security-policy",
        "frame-protection",
        "x-content-type-options",
        "referrer-policy",
        "strict-transport-security",
        "cookie-http-only",
        "cookie-secure",
        "cookie-same-site"
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "expectedStatus": {
      "oneOf": [
        { "type": "integer", "minimum": 100, "maximum": 599 },
        {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "uniqueItems": true
        }
      ]
    },
    "apiQuery": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
      }
    },
    "apiAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path": { "type": "string", "minLength": 1 },
        "profile": { "type": "string", "minLength": 1 },
        "headers": { "$ref": "#/definitions/stringMap" },
        "query": { "$ref": "#/definitions/apiQuery" },
        "body": {},
        "expected_status": { "$ref": "#/definitions/expectedStatus" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "apiAuthorizationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permission", "method", "path"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "permission": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] },
        "path": { "type": "string", "minLength": 1 },
        "allow": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "deny": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "headers": { "$ref": "#/definitions/stringMap" },
        "query": { "$ref": "#/definitions/apiQuery" },
        "body": {},
        "allow_status": { "$ref": "#/definitions/expectedStatus" },
        "deny_status": { "$ref": "#/definitions/expectedStatus" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "sourceCommand": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["executable"],
          "properties": {
            "executable": { "type": "string", "minLength": 1 },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
          }
        }
      ]
    }
  }
}
