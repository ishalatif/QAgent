{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "paths": {
      "#contracts": ["./packages/contracts/src/index.ts"],
      "#config": ["./packages/config/src/index.ts"],
      "#core": ["./packages/core/src/index.ts"],
      "#storage": ["./packages/storage/src/index.ts"],
      "#reporting": ["./packages/reporting/src/index.ts"],
      "#dashboard": ["./packages/dashboard/src/index.ts"],
      "#process-runner": ["./packages/process-runner/src/index.ts"],
      "#runtime-adapters": ["./packages/runtime-adapters/src/index.ts"],
      "#regression": ["./packages/regression/src/index.ts"],
      "#quality-adapters": ["./packages/quality-adapters/src/index.ts"],
      "#api-testing": ["./packages/api-testing/src/index.ts"],
      "#browser-playwright": ["./packages/browser-playwright/src/index.ts"],
      "#browser-tests": ["./packages/browser-tests/src/index.ts"]
    }
  }
}
